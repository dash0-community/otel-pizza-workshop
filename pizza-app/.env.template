# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Optional: which Dash0 dataset the telemetry lands in
DASH0_DATASET=default

# Optional: value of the deployment.environment.name resource attribute
DASH0_ENVIRONMENT=workshop

# Optional: OTLP transport. The endpoints above are OTLP/gRPC (port 4317).
# Switch to http/protobuf only if you also change DASH0_ENDPOINT to the
# OTLP/HTTP ingress (same host, no port).
DASH0_OTLP_PROTOCOL=grpc

# Optional: set to true to run the stack with telemetry switched off
OTEL_SDK_DISABLED=false

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
